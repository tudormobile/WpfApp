<Window x:Class="WpfApp0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp0"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="30">
            <TextBlock Text="{Binding Message, FallbackValue='something is not right'}" HorizontalAlignment="Center"/>
            <Button Content="Show MessageBox" Width="120" Height="30" Margin="20"
                    Command="{Binding ShowMessageCommand}"
                    CommandParameter="{Binding Message}"
                    />
        </StackPanel>
    </Grid>
</Window>
